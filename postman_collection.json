    {
      "name": "07. AI Syllabus Planner",
      "item": [
        {
          "name": "1. Generate AI Planner (Teacher)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.days && res.days.length > 0) {",
                  "  pm.collectionVariables.set('dayId', res.days[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classId\": \"{{classId}}\",\n  \"extractedSyllabusText\": \"Module 1: Distributed Architectures. Client-server, peer-to-peer. Module 2: Processes and Threads. Code migration. Module 3: Naming and Coordination. Module 4: Fault Tolerance and Paxos consensus.\",\n  \"numberOfDays\": 15,\n  \"regenerate\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/planner/generate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "planner", "generate"]
            },
            "description": "Calls Groq with 3x exponential backoff retry. Automatically caches in MongoDB immediately."
          }
        },
        {
          "name": "2. Get Full Planner (Teacher / Student)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/planner/{{classId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "planner", "{{classId}}"]
            }
          }
        },
        {
          "name": "3. Mark Planner Day Status (Teacher)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classId\": \"{{classId}}\",\n  \"dayId\": \"{{dayId}}\",\n  \"status\": \"done\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/planner/day",
              "host": ["{{baseUrl}}"],
              "path": ["api", "planner", "day"]
            }
          }
        }
      ]
    }
  ]
}
