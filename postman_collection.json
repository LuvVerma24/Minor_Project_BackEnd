              "mode": "raw",
              "raw": "{\n  \"role\": \"teacher\",\n  \"fullName\": \"Dr. Alan Turing\",\n  \"email\": \"turing@college.edu\",\n  \"password\": \"Secret123!\",\n  \"confirmPassword\": \"Secret123!\",\n  \"post\": \"Professor & HOD\",\n  \"department\": \"Computer Science\",\n  \"phone\": \"9876543210\"\n}"
