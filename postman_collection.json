    {
      "name": "04. Attendance",
      "item": [
        {
          "name": "1. Submit Today's Attendance (Teacher)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classId\": \"{{classId}}\",\n  \"date\": \"2026-10-06\",\n  \"records\": [\n    { \"rollNo\": \"CS-01\", \"status\": \"present\" },\n    { \"rollNo\": \"CS-02\", \"status\": \"absent\" },\n    { \"rollNo\": \"CS-03\", \"status\": \"present\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/attendance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance"]
            },
            "description": "Works with roll numbers directly without requiring student accounts to exist."
          }
        },
        {
          "name": "2. Edit Attendance Record (Teacher)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classId\": \"{{classId}}\",\n  \"rollNo\": \"CS-02\",\n  \"date\": \"2026-10-06\",\n  \"status\": \"present\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/attendance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance"]
            }
          }
        },
        {
          "name": "3. Teacher List Attendance (Paginated)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/attendance/{{classId}}?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance", "{{classId}}"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "date", "value": "2026-10-06", "disabled": true },
                { "key": "rollNo", "value": "CS-01", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "4. Student View Attendance (Read-Only Linked to RollNo)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
