        {
          "name": "1. Create Class (Teacher)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.classroom) {",
                  "  pm.collectionVariables.set('classId', res.classroom._id);",
                  "  pm.collectionVariables.set('joinCode', res.classroom.joinCode);",
                  "}"
