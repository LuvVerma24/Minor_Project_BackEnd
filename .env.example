# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Note: maxPoolSize=10 is enforced in code to comply with Atlas M0 free tier limits
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/faculty_portal?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Frontend CORS Origin (Strict security: cannot be "*")
# Set to your deployed frontend domain in production (e.g., https://my-college-portal.vercel.app)
# In development, you can use http://localhost:3000 or http://localhost:5173
ALLOWED_ORIGIN=http://localhost:3000

# Email Domain Restriction (Optional)
# If set, user emails during signup must end with this domain (e.g., college.edu)
# Leave blank to allow any valid email domain
ALLOWED_EMAIL_DOMAIN=

# Transactional Email Service (Resend or Brevo Free Tier)
# EMAIL_PROVIDER: "resend" or "brevo" (default is resend)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_123456789_abcdef
EMAIL_FROM=Faculty Portal <onboarding@resend.dev>

# Groq API for AI Syllabus Planner (Free tier at console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
